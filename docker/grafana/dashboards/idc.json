      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "습도 추이 (주황선 경고)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
