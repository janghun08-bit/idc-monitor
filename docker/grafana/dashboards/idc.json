                      "ACCESS": { "text": "출입", "index": 1 },
                      "ALARM_CLEAR": { "text": "경보 해제", "index": 2 },
                      "AGENT_OFFLINE": { "text": "연결 끊김", "index": 3 },
                      "AGENT_ONLINE": { "text": "연결 복구", "index": 4 }
                    }
