    {
      "id": 6,
      "type": "table",
      "title": "최근 이벤트",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 10 },
      "datasource": { "type": "mysql", "uid": "idc-mysql" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "idc-mysql" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"시각\", level AS \"단계\", event_type AS \"종류\", message AS \"내용\", agent_id AS \"장치\" FROM events ORDER BY ts DESC, id DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "시각" },
            "properties": [
              { "id": "unit", "value": "time:MM-DD HH:mm:ss" },
              { "id": "custom.width", "value": 150 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "단계" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.align", "value": "center" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "DANGER": { "text": "위험", "color": "red", "index": 0 },
