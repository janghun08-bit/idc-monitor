{
  "uid": "idc-monitor",
  "title": "서버실 환경·보안 관제",
  "description": "온도 색·기준선과 '현재 상태' 쿼리의 기준값은 서버 .env의 TEMP_WARN, TEMP_DANGER, HUMI_WARN, ACCESS_CM과 맞춰 둔다.",
  "tags": ["idc"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "annotations": {
    "list": [
      {
        "name": "경보 변화",
        "enable": true,
        "iconColor": "rgba(242, 73, 92, 0.8)",
        "datasource": { "type": "mysql", "uid": "idc-mysql" },
        "target": {
          "refId": "Anno",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, message AS text FROM events WHERE $__timeFilter(ts) AND event_type = 'STATE_CHANGE' ORDER BY ts"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 7,
      "type": "stat",
      "title": "현재 상태",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "mysql", "uid": "idc-mysql" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "idc-mysql" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN TIMESTAMPDIFF(SECOND, ts, UTC_TIMESTAMP()) > 15 THEN 'OFFLINE' WHEN leak = 1 OR temperature >= 25 THEN 'DANGER' WHEN temperature >= 23 OR humidity >= 70 THEN 'WARN' WHEN distance_cm < 30 THEN 'ACCESS' ELSE 'NORMAL' END AS \"상태\" FROM sensor_readings ORDER BY ts DESC, id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#2b3038", "value": null }] },
          "mappings": [
            {
              "type": "value",
              "options": {
                "NORMAL": { "text": "정상 운영", "color": "semi-dark-green", "index": 0 },
                "ACCESS": { "text": "출입 감지", "color": "blue", "index": 1 },
                "WARN": { "text": "경고", "color": "semi-dark-orange", "index": 2 },
                "DANGER": { "text": "위험", "color": "red", "index": 3 },
                "OFFLINE": { "text": "연결 끊김", "color": "#4a4f57", "index": 4 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "text": { "valueSize": 44 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": false }
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "온도",
      "gridPos": { "x": 6, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "mysql", "uid": "idc-mysql" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "idc-mysql" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, temperature AS \"온도\" FROM sensor_readings WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 23 },
              { "color": "red", "value": 25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "text": { "valueSize": 40 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "습도",
