              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "text": { "valueSize": 40 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "출입 거리 (30cm 미만 접근)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "mysql", "uid": "idc-mysql" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "idc-mysql" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT distance_cm AS \"거리\" FROM sensor_readings ORDER BY ts DESC, id DESC LIMIT 1"
